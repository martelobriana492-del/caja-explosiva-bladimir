
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Para mi Bladimir 💜</title>
<style>
*{box-sizing:border-box}
body{margin:0;text-align:center;font-family:Georgia,serif;color:#70449b;background:linear-gradient(145deg,#fffaff,#f1e5ff,#fce9f5)}
button{font:inherit;cursor:pointer;border:0;border-radius:24px;padding:12px 22px;background:linear-gradient(120deg,#b58be5,#e9a9d0);color:white}
.hidden{display:none!important}
#pinScreen{min-height:100vh;display:grid;place-items:center;padding:18px}
.phone{width:min(100%,350px);padding:26px 20px;background:#fffaff;border:7px solid white;border-radius:38px;box-shadow:0 12px 35px #7e55a333}
.lock{font-size:42px}
h1{color:#7847a6}
.pinDots{display:flex;justify-content:center;gap:11px;margin:22px}
.dot{width:12px;height:12px;border:1px solid #9a72c4;border-radius:50%}
.dot.filled{background:#9a72c4}
.keypad{display:grid;grid-template-columns:repeat(3,62px);justify-content:center;gap:9px}
.key{height:52px;border-radius:50%;background:#eee0ff;color:#63378a;font-size:21px;padding:0}
.note{min-height:20px;font-size:13px}
#giftScreen{padding:22px 10px 40px}
.subtitle{color:#8d6ca2}
.giftClosed{width:min(72vw,260px);height:210px;margin:45px auto 25px;position:relative;cursor:pointer}
.giftBody{position:absolute;bottom:0;left:5%;width:90%;height:150px;border:3px solid white;border-radius:8px 8px 16px 16px;background:linear-gradient(90deg,#bb98eb 0 35%,#f5b8d5 35% 65%,#bb98eb 65%);box-shadow:0 14px 20px #8059a333}
.giftHeart{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);font-size:65px;color:#fff4fa;text-shadow:0 2px 6px #a45b8a}
.giftLid{position:absolute;z-index:2;top:26px;left:0;width:100%;height:55px;border:3px solid white;border-radius:8px;background:linear-gradient(90deg,#b18ae4 0 35%,#f6c8df 35% 65%,#b18ae4 65%);transition:.8s}
.giftBow{position:absolute;z-index:3;top:-28px;left:50%;transform:translateX(-50%);font-size:60px}
.giftClosed.open .giftLid{transform:translate(30px,-100px) rotate(14deg);opacity:.7}
.giftClosed.open .giftBow{transform:translate(-30px,-90px) rotate(-15deg)}
.stage{width:100%;max-width:760px;margin:20px auto}
.explosion{position:relative;width:min(94vw,680px);aspect-ratio:1;margin:auto}
.flap{position:absolute;width:49%;height:49%;padding:7px;background:linear-gradient(145deg,#f9f1ff,#e4d0fc);border:2px solid #bd9ae4;box-shadow:0 5px 12px #7445a41b;display:flex;align-items:center;justify-content:center;opacity:0;transition:transform .9s,opacity .6s;overflow:hidden}
.inner{width:100%;height:100%;border:1px dashed #d0a7e7;border-radius:10px;padding:5px;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}
.flap h2{font-size:clamp(11px,2.5vw,19px);margin:3px;color:#77469d}
.flap p{font-size:clamp(9px,1.8vw,13px);line-height:1.3;margin:3px}
.flap.top{top:0;left:25.5%;border-radius:18px 18px 4px 4px}
.flap.bottom{bottom:0;left:25.5%;border-radius:4px 4px 18px 18px}
.flap.left{left:0;top:25.5%;border-radius:18px 4px 4px 18px}
.flap.right{right:0;top:25.5%;border-radius:4px 18px 18px 4px}
.explosion.open .flap{opacity:1}
.explosion.open .flap.top{transform:translateY(-17%)}
.explosion.open .flap.bottom{transform:translateY(17%)}
.explosion.open .flap.left{transform:translateX(-17%)}
.explosion.open .flap.right{transform:translateX(17%)}
.center{position:absolute;z-index:5;left:33%;top:33%;width:34%;height:34%;background:linear-gradient(145deg,#fff1d5,#f7d9a9);border:3px solid #c69a5e;border-radius:18px;box-shadow:0 7px 18px #6f4c8733;padding:5px;display:flex;flex-direction:column;align-items:center;justify-content:center}
.center .heart{font-size:clamp(28px,7vw,55px);color:#d95b9b;line-height:1}
.center h2{font-size:clamp(10px,2.5vw,18px);margin:4px;color:#784b76}
.center p{font-size:clamp(8px,1.7vw,12px);margin:2px}
.photoGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:3px;width:100%;max-height:78%;overflow:hidden}
.photoGrid img{width:100%;height:clamp(28px,6vw,55px);object-fit:cover;border:2px solid white;border-radius:5px}
.calendar{border-collapse:collapse;width:100%;font-size:clamp(8px,1.5vw,12px)}
.calendar td,.calendar th{padding:2px 0}
.mark{background:#e66aa8;color:white;border-radius:50%;font-weight:bold}
.coupon{max-width:100%;max-height:65%;object-fit:contain;border-radius:7px}
.timer{display:grid;grid-template-columns:repeat(2,1fr);gap:4px;width:100%}
.timer div{background:#f2e3ff;border-radius:8px;padding:4px}
.timer b{display:block;font-size:clamp(12px,2.4vw,19px)}
.timer span{font-size:9px}
.letter{width:min(94%,600px);margin:24px auto;background:linear-gradient(#fff3d7,#f9e5bc);border:1px solid #d0a96d;border-radius:14px;padding:20px;color:#54364c;font-family:"Brush Script MT","Segoe Script",cursive;font-style:italic;font-size:clamp(17px,3vw,23px);line-height:1.6;text-align:left;white-space:pre-wrap;box-shadow:inset 0 0 25px #c9a05c33}
.letterSign{text-align:right;font-weight:bold}
.audioBox{max-width:600px;margin:20px auto;padding:16px;border-radius:18px;background:#fffaff;border:1px solid #e1c8f3}
audio{width:100%}
.hint{font-size:13px;color:#8a69a0}
@media(max-width:440px){.flap{padding:3px}.inner{padding:2px}.flap h2{margin:1px 0;font-size:10px}.flap p{margin:1px;font-size:8px}.center{padding:2px}.center h2{font-size:10px}.center p{font-size:8px}.explosion{width:94vw}}
</style>
</head>
<body>

<section id="pinScreen">
 <div class="phone">
  <div class="lock">🔒</div>
  <h1>Para mi Bladimir 💜</h1>
  <p>Ingresa el PIN para abrir tu regalo</p>
  <div class="pinDots" id="pinDots">
   <span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span>
   <span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span>
  </div>
  <div class="keypad">
   <button class="key" data-key="1">1</button><button class="key" data-key="2">2</button><button class="key" data-key="3">3</button>
   <button class="key" data-key="4">4</button><button class="key" data-key="5">5</button><button class="key" data-key="6">6</button>
   <button class="key" data-key="7">7</button><button class="key" data-key="8">8</button><button class="key" data-key="9">9</button>
   <button class="key" data-key="clear">⌫</button><button class="key" data-key="0">0</button><button class="key" data-key="enter">✓</button>
  </div>
  <p class="note" id="pinNote">PIN de 8 dígitos</p>
 </div>
</section>

<main id="giftScreen" class="hidden">
 <h1>Feliz primer mes, mi amor 💜</h1>
 <p class="subtitle">Una caja explosiva llena de recuerdos, sorpresas y amor.</p>
 <div id="closedGift">
  <div class="giftClosed" id="giftClosed" role="button" tabindex="0" aria-label="Abrir caja">
   <div class="giftLid"></div><div class="giftBow">🎀</div>
   <div class="giftBody"><span class="giftHeart">♥</span></div>
  </div>
  <button id="openButton">Abrir mi regalo 🎁</button>
  <p class="hint">Toca la caja para desplegar las cuatro partes.</p>
 </div>

 <div id="explodedArea" class="hidden">
  <div class="stage">
   <div class="explosion" id="explosion">
    <section class="flap top"><div class="inner">
     <h2>📅 Nuestro comienzo</h2><p>Octubre 2026</p>
     <table class="calendar">
      <thead><tr><th>L</th><th>M</th><th>X</th><th>J</th><th>V</th><th>S</th><th>D</th></tr></thead>
      <tbody>
       <tr><td></td><td></td><td></td><td>1</td><td>2</td><td>3</td><td>4</td></tr>
       <tr><td>5</td><td><span class="mark">6 ♥</span></td><td>7</td><td>8</td><td>9</td><td>10</td><td>11</td></tr>
       <tr><td>12</td><td>13</td><td>14</td><td>15</td><td>16</td><td>17</td><td>18</td></tr>
       <tr><td>19</td><td>20</td><td>21</td><td>22</td><td>23</td><td>24</td><td>25</td></tr>
       <tr><td>26</td><td>27</td><td>28</td><td>29</td><td>30</td><td>31</td><td></td></tr>
      </tbody>
     </table>
     <p>El día que comenzó nuestra historia ❤️</p>
    </div></section>

    <section class="flap left"><div class="inner">
     <h2>🧸 De pequeñito</h2>
     <div class="photoGrid">
      <img src="foto1.jpg" alt="Foto 1"><img src="foto2.jpg" alt="Foto 2">
      <img src="foto3.jpg" alt="Foto 3"><img src="foto4.jpg" alt="Foto 4">
      <img src="foto5.jpg" alt="Foto 5"><img src="foto6.jpg" alt="Foto 6">
      <img src="foto7.jpg" alt="Foto 7">
     </div>
     <p>Siempre serás mi niño lindo 💗</p>
    </div></section>

    <section class="flap right"><div class="inner">
     <h2>🎟️ Mi cupón para ti</h2>
     <p>Una sorpresa dibujada con amor.</p>
     <img class="coupon" src="dibujo.jpg" alt="Dibujo del cupón">
     <p>Hecho especialmente para ti 💕</p>
    </div></section>

    <section class="flap bottom"><div class="inner">
     <h2>⏳ Nuestro tiempo</h2>
     <p>Desde el 6 de octubre de 2026 · 3:56 p. m.</p>
     <div class="timer">
      <div><b id="days">0</b><span>Días</span></div>
      <div><b id="hours">00</b><span>Horas</span></div>
      <div><b id="minutes">00</b><span>Minutos</span></div>
      <div><b id="seconds">00</b><span>Segundos</span></div>
     </div>
     <p>Y contando... ❤️</p>
    </div></section>

    <section class="center">
     <div class="heart">♥</div><h2>Una carta para ti</h2>
     <p>Con todo mi amor, Bry 💌</p>
    </section>
   </div>
  </div>

  <div class="letter">Hoy amor ya cumplimos nuestro primer mes, y espero q sea el primero de muchos más, por q no quiero que esto acabe. En este tiempo q te he conocido y q soy tú novia me he sentido muy feliz, me encanta la forma en la q me tratas, en la q me das amor, en la q me entiendes. Nunca nadie me había tenido tanta paciencia como tú la tienes conmigo.

Se q no soy la mejor novia, estoy intentando cambiar por tí, para ser mejor persona. Se q a veces la embarró, y la cago muy feo, y quizás pienses q no me importa lo q hago o en q te afecta.

Hace mucho no sentía este amor como el que siento por tí, es sincero, y cada día te amo más. No me cansaría de amarte, por q sé q te mereces todo el amor q te puedo dar.

Gracias por estar conmigo, y por quererme así como soy.

Te amo mucho y feliz primer mes.

<div class="letterSign">DE: Bry<br>PARA: Él amor de mi vida 🖤</div></div>

  <div class="audioBox">
   <h2>🎶 Nuestra música</h2>
   <p>Presiona reproducir para escuchar la melodía.</p>
   <audio controls preload="none"><source src="musica.mp3" type="audio/mpeg"></audio>
   <p class="hint">Para que suene aquí, sube un audio autorizado con el nombre musica.mp3.</p>
  </div>
 </div>
</main>

<script>
let pin="";
const dots=[...document.querySelectorAll(".dot")];
const note=document.getElementById("pinNote");

function updateDots(){
 dots.forEach((d,i)=>d.classList.toggle("filled",i<pin.length));
}

function keyPress(k){
 if(k==="clear"){
  pin=pin.slice(0,-1);
  note.textContent="PIN de 8 dígitos";
  updateDots();
  return;
 }
 if(k==="enter"){
  if(pin==="06102026"){
   document.getElementById("pinScreen").classList.add("hidden");
   document.getElementById("giftScreen").classList.remove("hidden");
  }else{
   note.textContent="PIN incorrecto, inténtalo otra vez 💜";
   pin="";
  }
  updateDots();
  return;
 }
 if(pin.length<8){
  pin+=k;
  updateDots();
  if(pin.length===8) note.textContent="Pulsa ✓ para abrir";
 }
}

document.querySelectorAll("[data-key]").forEach(b=>{
 b.addEventListener("click",()=>keyPress(b.dataset.key));
});

function openGift(){
 document.getElementById("giftClosed").classList.add("open");
 document.getElementById("closedGift").classList.add("hidden");
 document.getElementById("explodedArea").classList.remove("hidden");
 requestAnimationFrame(()=>{
  document.getElementById("explosion").classList.add("open");
 });
 setTimeout(()=>{
  document.getElementById("explodedArea").scrollIntoView({
   behavior:"smooth",block:"start"
  });
 },180);
}

document.getElementById("openButton").addEventListener("click",openGift);
document.getElementById("giftClosed").addEventListener("click",openGift);

document.getElementById("giftClosed").addEventListener("keydown",e=>{
 if(e.key==="Enter"||e.key===" "){
  e.preventDefault();
  openGift();
 }
});

function timer(){
 const start=new Date(2026,9,6,15,56,0).getTime();
 let n=Math.max(0,Date.now()-start);
 const d=Math.floor(n/86400000);
 n%=86400000;
 const h=Math.floor(n/3600000);
 n%=3600000;
 const m=Math.floor(n/60000);
 n%=60000;
 const s=Math.floor(n/1000);

 document.getElementById("days").textContent=d;
 document.getElementById("hours").textContent=String(h).padStart(2,"0");
 document.getElementById("minutes").textContent=String(m).padStart(2,"0");
 document.getElementById("seconds").textContent=String(s).padStart(2,"0");
}

timer();
setInterval(timer,1000);
</script>
</body>
</html>
